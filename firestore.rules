rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function userData(uid) { return get(userPath(uid)).data; }
    function currentUser() { return userData(request.auth.uid); }
    function role() { return currentUser().role; }
    function isModerator() { return signedIn() && role() in ["moderator", "admin", "super_admin"]; }
    function isAdmin() { return signedIn() && role() in ["admin", "super_admin"]; }
    function isSuperAdmin() { return signedIn() && role() == "super_admin"; }
    function notRestricted() {
      return signedIn()
        && (!("banned" in currentUser()) || currentUser().banned != true)
        && (!("suspended" in currentUser()) || currentUser().suspended != true);
    }

    function hasActiveFreeCharityYear(data) {
      return data.accessType == "admin_granted_free_year" && data.freeAccessExpiresAt > request.time;
    }
    function hasActivePaidAccess(data) {
      return data.hasSubscription == true && (
        (data.subscriptionStatus == "active"
          && (!("subscriptionExpiresAt" in data) || data.subscriptionExpiresAt == null || data.subscriptionExpiresAt > request.time))
        // Cancelled subscriptions keep access until the paid period ends.
        || (data.subscriptionStatus == "cancelling"
          && "subscriptionExpiresAt" in data
          && data.subscriptionExpiresAt is timestamp
          && data.subscriptionExpiresAt > request.time)
      );
    }
    function hasActiveFoundingAccess(data) {
      return data.isFoundingMember == true
        && (data.subscriptionBillingType == "founding-free-year" || data.subscriptionPlan == "founding" || data.membershipPlan == "founding")
        && (!("subscriptionExpiresAt" in data) || data.subscriptionExpiresAt == null || data.subscriptionExpiresAt > request.time);
    }
    function hasLifetimeAccess(data) {
      return data.hasSubscription == true
        && data.subscriptionStatus == "active"
        && (data.subscriptionPlan == "lifetime" || data.membershipPlan == "lifetime" || data.subscriptionBillingType == "internal-lifetime");
    }
    function hasActiveMembership() {
      return signedIn() && notRestricted() && (
        role() in ["admin", "super_admin"] ||
        hasLifetimeAccess(currentUser()) ||
        hasActiveFreeCharityYear(currentUser()) ||
        hasActiveFoundingAccess(currentUser()) ||
        hasActivePaidAccess(currentUser())
      );
    }

    function publicProfileKeys() {
      return [
        "uid", "fullName", "displayName", "businessName", "serviceTitle", "description", "whyContact", "tags",
        "yearsExperience", "specialistWork", "googleReviews", "gurdwaraId", "gurdwaraName", "associatedGurdwara",
        "localGurdwara", "communityDiscount", "funFactOne", "funFactTwo", "phone", "email", "website", "linkedin",
        "town", "postcode", "serviceArea", "layoutStyle", "themeColour", "isPublic", "showPhone", "showEmail",
        "showPostcode", "showGurdwara", "showGoogleReviews", "profilePhotoUrl", "businessLogoUrl",
        "connectionPrivacy", "messagePrivacy", "allowMessageNotifications", "projectsUserType", "projectsUserTypeUpdatedAt", "hasSeenIntro", "updatedAt"
      ];
    }
    function privilegedUserKeys() {
      return [
        "role", "accountType", "isAdmin", "internalAccount", "excludeFromFoundingMemberCount", "canImpersonateUsers",
        "impersonationReady", "canViewHiddenDiagnostics", "hasSubscription", "subscriptionStatus", "subscriptionPlan",
        "subscriptionBillingType", "subscriptionExpiresAt", "subscriptionUpdatedAt", "subscriptionCancelAtPeriodEnd",
        "subscriptionCancelledAt", "subscriptionEndedAt", "subscriptionPaymentFailedAt", "stripeCustomerId",
        "stripeSubscriptionId", "stripePriceId", "stripeCheckoutSessionId", "checkoutSessionId", "membershipPlan",
        "membershipStatus", "isFoundingMember", "memberNumber", "accessType", "freeAccessReason", "freeAccessExpiresAt",
        "freeAccessGrantedAt", "freeAccessGrantedBy", "charityName", "adminNotes", "featuredListing",
        "featuredListingStatus", "featuredExpiresAt", "featuredStripePriceId", "featuredStripeSessionId",
        "featuredStripeCustomerId", "featuredUpdatedAt", "tradesJobAccess", "tradesJobAccessStatus",
        "tradesJobAccessPaidAt", "tradesJobAccessExpiresAt", "tradesJobAccessAmount", "tradesJobAccessStripePriceId",
        "tradesJobAccessStripeSessionId", "tradesJobAccessStripeCustomerId", "tradesJobAccessUpdatedAt",
        "messagingRestricted", "messagingRestrictedAt", "messagingRestrictedBy", "banned", "suspended", "adminHidden", "pinnedToTop", "activeDays", "lastActiveAt", "cardPhoto"
      ];
    }
    function validSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(publicProfileKeys())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserKeys())
        && request.resource.data.uid == resource.data.uid;
    }
    function paidSignupKeys() {
      return [
        "uid", "fullName", "displayName", "email", "role", "internalAccount", "accountType", "isAdmin",
        "isFoundingMember", "memberNumber", "hasSubscription", "subscriptionStatus", "subscriptionPlan",
        "subscriptionBillingType", "subscriptionExpiresAt", "subscriptionUpdatedAt", "membershipPlan",
        "membershipStatus", "stripeCustomerId", "stripeSubscriptionId", "stripePriceId", "stripeCheckoutSessionId",
        "featuredListing", "featuredListingStatus", "featuredExpiresAt", "hasSeenIntro", "isPublic", "createdAt", "updatedAt"
      ];
    }
    // The claimed checkout session is written server-side by verifyPaidSignupSession, so every
    // membership field must match it; the client can't grant itself a role, plan or longer expiry.
    function validPaidSignupCreate(uid) {
      let data = request.resource.data;
      let sessionPath = /databases/$(database)/documents/usedSignupCheckoutSessions/$(data.stripeCheckoutSessionId);
      let claimed = get(sessionPath).data;
      return data.uid == uid
        && data.stripeCheckoutSessionId is string
        && exists(sessionPath)
        && claimed.uid == uid
        && data.keys().hasOnly(paidSignupKeys())
        && data.role == "standard"
        && data.isAdmin == false
        && data.internalAccount == false
        && data.accountType == "member"
        && data.isFoundingMember == false
        && data.memberNumber == null
        && data.hasSubscription == true
        && data.subscriptionStatus == "active"
        && data.membershipStatus == "active"
        && data.subscriptionPlan == claimed.planName
        && data.membershipPlan == claimed.planName
        && data.subscriptionBillingType == claimed.billingType
        && data.stripePriceId == claimed.stripePriceId
        && data.stripeCustomerId == claimed.stripeCustomerId
        && data.stripeSubscriptionId == claimed.stripeSubscriptionId
        && data.featuredListing == false
        && data.featuredExpiresAt == null
        && (
          (claimed.billingType == "subscription" && data.subscriptionExpiresAt == null)
          || (claimed.billingType == "oneoff"
            && data.subscriptionExpiresAt is timestamp
            && data.subscriptionExpiresAt <= request.time
              + duration.value(claimed.planName == "yearly" ? 366 : 31, "d"))
        );
    }
    function validBasicUserCreate(uid) {
      return request.resource.data.uid == uid
        && !request.resource.data.keys().hasAny(privilegedUserKeys());
    }

    function project(projectId) { return get(/databases/$(database)/documents/projects/$(projectId)).data; }
    function isProjectOwner(projectId) { return signedIn() && project(projectId).ownerId == request.auth.uid; }
    function teamDocId(projectId, uid) { return projectId + "__" + uid; }
    function isProjectTeamMember(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projectTeams/$(teamDocId(projectId, request.auth.uid)))
        && get(/databases/$(database)/documents/projectTeams/$(teamDocId(projectId, request.auth.uid))).data.status == "active";
    }
    function canAccessWorkspace(projectId) {
      return hasActiveMembership()
        && (isSuperAdmin() || isProjectOwner(projectId) || isProjectTeamMember(projectId))
        && (isSuperAdmin() || project(projectId).workspaceUnlocked == true);
    }
    function isWorkspaceCollection(name) {
      return name in [
        "workspaceTasks", "workspaceNotes", "workspaceActivity", "workspaceMilestones", "workspaceDocuments",
        "workspacePhotos", "workspaceQuotes", "workspaceMessages", "workspaceBudgetItems"
      ];
    }
    function participates(ids) { return signedIn() && request.auth.uid in ids; }

    // Full user records hold private data; other members read publicProfiles instead.
    // How the site's own pictures (founder photos, SayVah images) are framed.
    // Everyone reads; only the super admin changes them (js/site-images.js).
    match /siteImages/{imageId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        && imageId.matches("[a-z0-9-]{1,60}")
        && request.resource.data.keys().hasOnly(["x", "y", "zoom", "updatedAt", "updatedBy"])
        && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
        && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
        && request.resource.data.zoom is number && request.resource.data.zoom >= 1 && request.resource.data.zoom <= 3
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // Homepage totals written by the site-stats Cloud Functions: counts only.
    match /siteStats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicProfiles/{uid} {
      allow get: if true;
      allow list: if hasActiveMembership() || isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid) && (validBasicUserCreate(uid) || validPaidSignupCreate(uid));
      allow update: if (isSelf(uid) && validSelfProfileUpdate()) || isSuperAdmin();
      allow delete: if isSuperAdmin() && resource.data.internalAccount != true;

      // Public reviews (js/reviews.js): one per reviewer, stored under their uid,
      // with no email or other private details.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if hasActiveMembership()
          && reviewId == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(["profileId", "reviewerId", "reviewerName", "serviceUsed", "rating", "reviewText", "createdAt"])
          && request.resource.data.profileId == uid
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.reviewerName is string && request.resource.data.reviewerName.size() > 0 && request.resource.data.reviewerName.size() <= 120
          && request.resource.data.get("serviceUsed", "") is string && request.resource.data.get("serviceUsed", "").size() <= 120
          && request.resource.data.reviewText is string && request.resource.data.reviewText.size() >= 5 && request.resource.data.reviewText.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }
    }

    // Opportunities board (js/opportunities.js): jobs, freelance work, collaborations,
    // mentoring and volunteering from any industry. Members read and post; the poster
    // edits, closes or deletes their own; admins can close or delete any post.
    function validOpportunity(data) {
      return data.keys().hasOnly(["ownerId", "type", "title", "industry", "description", "location", "remote",
          "pay", "closingDate", "applyLink", "status", "createdAt", "updatedAt", "featuredUntil", "featuredSessionId"])
        && data.keys().hasAll(["ownerId", "type", "title", "industry", "description", "location", "remote",
          "pay", "closingDate", "applyLink", "status", "createdAt", "updatedAt"])
        && data.type in ["job", "freelance", "collaboration", "mentoring", "volunteering"]
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.industry is string && data.industry.size() <= 60
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 3000
        && data.location is string && data.location.size() <= 80
        && data.remote is bool
        && data.pay is string && data.pay.size() <= 80
        && data.closingDate is string && (data.closingDate == "" || data.closingDate.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}"))
        && data.applyLink is string && data.applyLink.size() <= 300 && (data.applyLink == "" || data.applyLink.matches("https?://.+"))
        && data.status in ["open", "closed"];
    }

    // featuredUntil/featuredSessionId are only set by the Stripe webhook (functions/promotions.js).
    function keepsFeaturedFields() {
      return request.resource.data.get("featuredUntil", null) == resource.data.get("featuredUntil", null)
        && request.resource.data.get("featuredSessionId", null) == resource.data.get("featuredSessionId", null);
    }

    match /opportunities/{opportunityId} {
      allow read: if hasActiveMembership();
      allow create: if hasActiveMembership()
        && validOpportunity(request.resource.data)
        && !("featuredUntil" in request.resource.data)
        && !("featuredSessionId" in request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasActiveMembership() && (
        (resource.data.ownerId == request.auth.uid
          && validOpportunity(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && keepsFeaturedFields())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status in ["open", "closed"])
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Marketplace (marketplace.html, js/marketplace.js): members sell things to
    // each other. Buyers message the seller; no payments go through the site.
    function validListing(data) {
      return data.keys().hasOnly(["ownerId", "title", "description", "price", "priceType", "category",
          "condition", "town", "photos", "status", "createdAt", "updatedAt"])
        && data.keys().hasAll(["ownerId", "title", "description", "price", "priceType", "category",
          "condition", "town", "photos", "status", "createdAt", "updatedAt"])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && data.priceType in ["fixed", "offers", "free"]
        && data.category in ["home-garden", "furniture", "electronics", "vehicles", "clothing",
          "baby-kids", "sports-leisure", "books-music", "tools-diy", "cultural", "other"]
        && data.condition in ["new", "like-new", "good", "fair"]
        && data.town is string && data.town.size() >= 2 && data.town.size() <= 80
        && data.photos is list && data.photos.size() <= 4
        && data.status in ["active", "sold"];
    }

    match /marketplaceListings/{listingId} {
      allow read: if hasActiveMembership();
      allow create: if hasActiveMembership()
        && validListing(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasActiveMembership() && (
        (resource.data.ownerId == request.auth.uid
          && resource.data.status != "removed"
          && validListing(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status in ["active", "removed"])
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Learning Hub (learning.html, js/learning.js): members ask questions and share
    // guides, reply, and upvote. voteCount, replyCount and lastActivityAt are kept
    // up to date by Cloud Functions (functions/learning.js), never by the browser.
    function validLink(link) {
      return link is string && link.size() <= 300
        && (link == "" || link.matches("https?://[^\\s]+"));
    }

    function validLearnPost(data) {
      return data.keys().hasOnly(["ownerId", "kind", "topic", "title", "body", "link", "status",
          "createdAt", "updatedAt", "voteCount", "replyCount", "lastActivityAt"])
        && data.keys().hasAll(["ownerId", "kind", "topic", "title", "body", "link", "status", "createdAt", "updatedAt"])
        && data.kind in ["question", "guide"]
        && data.topic in ["maths", "english", "science", "coding", "diy", "business", "careers", "punjabi-sikhi", "other"]
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 150
        && data.body is string && data.body.size() <= 5000
        && validLink(data.link)
        && data.status == "active";
    }

    function validLearnReply(data) {
      return data.keys().hasOnly(["ownerId", "body", "link", "status", "createdAt", "updatedAt", "voteCount"])
        && data.keys().hasAll(["ownerId", "body", "link", "status", "createdAt", "updatedAt"])
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 3000
        && validLink(data.link)
        && data.status == "active";
    }

    function keepsServerCounts(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    match /learnPosts/{postId} {
      allow read: if hasActiveMembership();
      allow create: if hasActiveMembership()
        && validLearnPost(request.resource.data)
        && !request.resource.data.keys().hasAny(["voteCount", "replyCount", "lastActivityAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasActiveMembership() && (
        (resource.data.ownerId == request.auth.uid
          && resource.data.status == "active"
          && validLearnPost(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && keepsServerCounts(["voteCount", "replyCount", "lastActivityAt"]))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status in ["active", "removed"])
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /replies/{replyId} {
        allow read: if hasActiveMembership();
        allow create: if hasActiveMembership()
          && validLearnReply(request.resource.data)
          && !("voteCount" in request.resource.data)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/learnPosts/$(postId)).data.status == "active";
        allow update: if hasActiveMembership() && (
          (resource.data.ownerId == request.auth.uid
            && resource.data.status == "active"
            && validLearnReply(request.resource.data)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && keepsServerCounts(["voteCount"]))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
            && request.resource.data.status in ["active", "removed"])
        );
        allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        // One upvote per member per reply; the doc ID is the voter's uid.
        match /votes/{voterId} {
          allow read: if hasActiveMembership();
          allow create: if hasActiveMembership() && voterId == request.auth.uid
            && request.resource.data.keys().hasOnly(["createdAt"])
            && request.resource.data.createdAt == request.time;
          allow delete: if signedIn() && voterId == request.auth.uid;
        }
      }

      // One upvote per member per post; the doc ID is the voter's uid.
      match /votes/{voterId} {
        allow read: if hasActiveMembership();
        allow create: if hasActiveMembership() && voterId == request.auth.uid
          && request.resource.data.keys().hasOnly(["createdAt"])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && voterId == request.auth.uid;
      }
    }

    // Reports on Learning Hub posts or replies: any member can file one; only admins read them.
    match /learnReports/{reportId} {
      allow create: if hasActiveMembership()
        && request.resource.data.keys().hasOnly(["postId", "replyId", "reporterId", "reason", "status", "createdAt"])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.replyId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 500
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Free trial codes for events (functions/trials.js). Admins create and manage
    // them; members never read them directly (the freeTrial function checks codes).
    match /trialCodes/{code} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && code.matches("[A-Z0-9-]{3,32}")
        && request.resource.data.keys().hasOnly(["code", "days", "maxUses", "uses", "expiresAt", "active", "label", "createdAt", "createdBy"])
        && request.resource.data.code == code
        && request.resource.data.days in [7, 14, 30]
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 5000
        && request.resource.data.uses == 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.active == true
        && request.resource.data.label is string && request.resource.data.label.size() <= 80
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "maxUses", "expiresAt", "label"])
        && request.resource.data.active is bool
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 5000;
    }

    // Invite a friend (functions/referrals.js). Written only by Cloud Functions;
    // members can see the invites they sent, and their own.
    match /referrals/{referredUid} {
      allow read: if signedIn() && (resource.data.referrerUid == request.auth.uid
        || resource.data.referredUid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Reports on listings: any member can file one; only admins read them.
    match /marketplaceReports/{reportId} {
      allow create: if hasActiveMembership()
        && request.resource.data.keys().hasOnly(["listingId", "reporterId", "reason", "status", "createdAt"])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 500
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Paid job posts from non-member employers (functions/employer-jobs.js). Created and
    // marked paid only by the server; admins approve, reject or take them down.
    match /employerJobs/{jobId} {
      allow get, list: if (hasActiveMembership() && resource.data.status == "live") || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "liveUntil", "reviewedAt", "reviewedBy", "reviewNote"])
        && request.resource.data.status in ["live", "rejected", "removed"];
      allow create: if false;
      allow delete: if isAdmin();
    }

    // The employer's own contact details: admins only.
    match /employerJobContacts/{jobId} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if hasActiveMembership();
      allow create: if hasActiveMembership()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.workspaceUnlocked == false
        && request.resource.data.workspacePaymentStatus == "locked";
      allow update: if hasActiveMembership() && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "titleLower", "projectType", "description", "location", "locationLower", "budget",
            "estimatedStart", "estimatedFinish", "requiredTrades", "filledTradeRoles", "status", "progressStage",
            "applicantCount", "pendingApplicantCount", "acceptedApplicantCount", "rejectedApplicantCount", "teamCount", "updatedAt"
          ]))
      );
      allow delete: if isSuperAdmin();
    }

    match /applications/{applicationId} {
      allow read: if hasActiveMembership() && (resource.data.applicantId == request.auth.uid || resource.data.projectOwnerId == request.auth.uid || isSuperAdmin());
      allow create: if hasActiveMembership()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.projectOwnerId != request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if hasActiveMembership() && (
        (resource.data.projectOwnerId == request.auth.uid && request.resource.data.projectOwnerId == resource.data.projectOwnerId && request.resource.data.applicantId == resource.data.applicantId)
        || (resource.data.applicantId == request.auth.uid && request.resource.data.status in ["withdrawn"])
        || isSuperAdmin()
      );
      allow delete: if hasActiveMembership() && (resource.data.applicantId == request.auth.uid || isSuperAdmin());
    }

    match /projectTeams/{teamId} {
      allow read: if hasActiveMembership() && (resource.data.memberId == request.auth.uid || resource.data.projectOwnerId == request.auth.uid || isSuperAdmin());
      allow create: if hasActiveMembership()
        && teamId == request.resource.data.projectId + "__" + request.resource.data.memberId
        && request.resource.data.projectOwnerId == request.auth.uid
        && request.resource.data.memberId != request.auth.uid
        && request.resource.data.status == "active";
      allow update: if hasActiveMembership() && (resource.data.projectOwnerId == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /{workspaceCollection}/{itemId} {
      allow read: if isWorkspaceCollection(workspaceCollection) && canAccessWorkspace(resource.data.projectId);
      allow create: if isWorkspaceCollection(workspaceCollection)
        && canAccessWorkspace(request.resource.data.projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isWorkspaceCollection(workspaceCollection)
        && canAccessWorkspace(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isWorkspaceCollection(workspaceCollection) && canAccessWorkspace(resource.data.projectId);
    }

    match /gurdwaras/{gurdwaraId} {
      allow read: if hasActiveMembership();
      allow create: if hasActiveMembership() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
      match /pools/{poolId} {
        allow read: if hasActiveMembership();
        allow create, update, delete: if isAdmin();
      }
    }

    // Retired skills pools/roles (replaced by the automatic Gurdwara Network,
    // js/skills-network.js). Kept readable for admins; nothing new can be added.
    match /pools/{poolId} {
      allow read, delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read, delete: if isAdmin();
    }

    match /roleMembers/{roleMemberId} {
      allow read, delete: if isAdmin();
    }

    match /youngProfessionals/{uid} {
      allow read: if hasActiveMembership();
      // Every member can read these, so no email address is stored.
      allow create, update: if isSelf(uid) && hasActiveMembership()
        && request.resource.data.uid == request.auth.uid
        && !("email" in request.resource.data);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if resource.data.status == "answered" || isAdmin();
      allow create: if request.resource.data.status == "pending" && request.resource.data.answer == "";
      allow update, delete: if isAdmin();
    }

    match /futureFeatures/{featureId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
      match /votes/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    match /connections/{connectionId} {
      allow read: if participates(resource.data.userIds);
      allow create, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if participates(resource.data.participantIds);
      allow create, update, delete: if false;
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/conversations/$(conversationId)).data; }
        allow read: if participates(parent().participantIds);
        allow create, update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt", "archived", "updatedAt"]);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    match /reports/{reportId} {
      allow read: if isModerator() || resource.data.reporterId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /usedSignupCheckoutSessions/{sessionId} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /freeAccessInvites/{inviteId} { allow read, write: if false; }
    match /freeAccessGrantLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
    match /adminAuditLogs/{logId} { allow read: if isAdmin(); allow write: if false; }

    // Shaheed Parivars thank-you messages. Anyone may submit; nothing is public until
    // an admin approves it. Email lives in parivarMessageContacts so it's never public.
    function validParivarMessage(messageId) {
      let data = request.resource.data;
      return data.keys().hasOnly(["name", "message", "videoPath", "status", "createdAt"])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.status == "pending"
        && data.createdAt == request.time
        && (data.videoPath == "" || data.videoPath.matches("parivarVideos/" + messageId + "/video[.][a-z0-9]{2,5}"));
    }
    match /parivarMessages/{messageId} {
      allow get, list: if resource.data.status == "approved" || isAdmin();
      allow create: if validParivarMessage(messageId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy"])
        && request.resource.data.status in ["pending", "approved", "hidden"];
      allow delete: if isAdmin();
    }
    match /parivarMessageContacts/{messageId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(["email", "createdAt"])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches("[^@ ]+@[^@ ]+[.][^@ ]+")
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/parivarMessages/$(messageId))
        && !exists(/databases/$(database)/documents/parivarMessages/$(messageId));
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}






